+/*
+ * Samples are pushed from the HID event handler, so the trigger never fires;
+ * a threaded handler is still required since the pollfunc is IRQF_ONESHOT.
+ */
+static irqreturn_t appleals_trigger_handler(int irq, void *p)
+{
+	struct iio_poll_func *pf = p;
+
+	iio_trigger_notify_done(pf->indio_dev->trig);
+
+	return IRQ_HANDLED;
+}

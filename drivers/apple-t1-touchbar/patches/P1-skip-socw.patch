-	if (ACPI_FAILURE(sts))
-		dev_warn(LOG_DEV(ib_dev), "SOCW(1) failed: %s\n",
-			 acpi_format_exception(sts));
+	if (appleib_skip_acpi_power()) {
+		dev_info(LOG_DEV(ib_dev), "skipping ASOC.SOCW (skip_acpi_power)\n");
+	} else {
+		sts = acpi_execute_simple_method(ib_dev->asoc_socw, NULL, 1);
+		if (ACPI_FAILURE(sts))
+			dev_warn(LOG_DEV(ib_dev), "SOCW(1) failed: %s\n",
+				 acpi_format_exception(sts));
+	}
 
 	return ib_dev;
 }
